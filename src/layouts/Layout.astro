---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Big Archive System Design 2025 - An interactive knowledge base for system design, AI, and software engineering.' } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>
    <ClientRouter />
    <script is:inline>
      (function() {
        const theme = localStorage.getItem('theme');
        if (theme === 'dark' || (!theme && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
          document.documentElement.classList.add('dark');
        }
      })();
    </script>
  </head>
  <body class="min-h-screen flex flex-col bg-stone-50 dark:bg-stone-950">
    <!-- Page transition overlay -->
    <div id="page-transition-overlay" style="
      position: fixed;
      inset: 0;
      z-index: 99999;
      pointer-events: none;
      background: #0c0a09;
      opacity: 0;
      transform: translateY(100%);
      transition: none;
    "></div>

    <!-- Cursor Trail Canvas -->
    <canvas id="cursor-trail" class="fixed inset-0 pointer-events-none z-[9999]" style="mix-blend-mode: screen;"></canvas>

    <slot />

    <script is:inline>
      // ===== THEME TOGGLE WITH BURST ANIMATION =====
      function initThemeToggle() {
        const themeToggle = document.getElementById('theme-toggle');
        if (!themeToggle || themeToggle.dataset.initialized) return;
        themeToggle.dataset.initialized = 'true';

        themeToggle.addEventListener('click', () => {
          const html = document.documentElement;
          const isDark = html.classList.contains('dark');
          const rect = themeToggle.getBoundingClientRect();
          const cx = rect.left + rect.width / 2;
          const cy = rect.top + rect.height / 2;

          // Create expanding circle overlay
          const circle = document.createElement('div');
          const color = isDark ? '#ffffff' : '#000000';
          const maxRadius = Math.max(
            Math.hypot(cx, cy),
            Math.hypot(window.innerWidth - cx, cy),
            Math.hypot(cx, window.innerHeight - cy),
            Math.hypot(window.innerWidth - cx, window.innerHeight - cy)
          );

          circle.style.cssText = `
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            z-index: 99999;
            pointer-events: none;
            clip-path: circle(0% at ${cx}px ${cy}px);
            background: ${color};
            transition: clip-path 0.6s cubic-bezier(0.22, 1, 0.36, 1);
          `;
          document.body.appendChild(circle);

          // Force reflow
          void circle.offsetWidth;

          // Animate circle expanding
          circle.style.clipPath = `circle(${maxRadius}px at ${cx}px ${cy}px)`;

          // Swap theme at midpoint
          setTimeout(() => {
            if (isDark) {
              html.classList.remove('dark');
              localStorage.setItem('theme', 'light');
            } else {
              html.classList.add('dark');
              localStorage.setItem('theme', 'dark');
            }
          }, 300);

          // Fade out and remove
          setTimeout(() => {
            circle.style.transition = 'opacity 0.4s ease';
            circle.style.opacity = '0';
          }, 600);

          setTimeout(() => {
            circle.remove();
          }, 1000);
        });
      }

      // ===== PAGE TRANSITIONS =====
      function initPageTransitions() {
        const overlay = document.getElementById('page-transition-overlay');
        if (!overlay) return;

        document.addEventListener('astro:before-preparation', () => {
          overlay.style.transition = 'none';
          overlay.style.opacity = '0';
          overlay.style.transform = 'translateY(100%)';
          void overlay.offsetWidth;
          overlay.style.transition = 'transform 0.4s cubic-bezier(0.4, 0, 0.2, 1)';
          overlay.style.transform = 'translateY(0%)';
        });

        document.addEventListener('astro:after-swap', () => {
          overlay.style.transition = 'transform 0.5s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.3s ease';
          overlay.style.transform = 'translateY(-100%)';
          overlay.style.opacity = '0';
        });
      }

      // ===== CURSOR TRAIL EFFECT =====
      function initCursorTrail() {
        const canvas = document.getElementById('cursor-trail');
        if (!canvas || canvas.dataset.initialized) return;
        canvas.dataset.initialized = 'true';

        const ctx = canvas.getContext('2d');
        let width = window.innerWidth;
        let height = window.innerHeight;
        canvas.width = width;
        canvas.height = height;

        const particles = [];
        let lastMouseX = -1000;
        let lastMouseY = -1000;

        const isTouchDevice = window.matchMedia('(pointer: coarse)').matches;
        if (isTouchDevice) return;

        document.addEventListener('mousemove', (e) => {
          const speed = Math.hypot(e.clientX - lastMouseX, e.clientY - lastMouseY);
          if (speed > 2) {
            const count = Math.min(Math.floor(speed / 5), 5);
            for (let i = 0; i < count; i++) {
              particles.push({
                x: e.clientX + (Math.random() - 0.5) * 10,
                y: e.clientY + (Math.random() - 0.5) * 10,
                vx: (Math.random() - 0.5) * 2,
                vy: (Math.random() - 0.5) * 2 - 1,
                life: 1,
                maxLife: 30 + Math.random() * 30,
                size: Math.random() * 3 + 1,
                hue: 150 + Math.random() * 40,
              });
            }
          }
          lastMouseX = e.clientX;
          lastMouseY = e.clientY;
        });

        function animate() {
          ctx.clearRect(0, 0, width, height);
          for (let i = particles.length - 1; i >= 0; i--) {
            const p = particles[i];
            p.life -= 1 / p.maxLife;
            p.x += p.vx;
            p.y += p.vy;
            p.vy += 0.05;
            if (p.life <= 0) {
              particles.splice(i, 1);
              continue;
            }
            const alpha = p.life * 0.6;
            ctx.beginPath();
            ctx.arc(p.x, p.y, p.size * p.life, 0, Math.PI * 2);
            ctx.fillStyle = `hsla(${p.hue}, 80%, 60%, ${alpha})`;
            ctx.fill();
            ctx.beginPath();
            ctx.arc(p.x, p.y, p.size * p.life * 2, 0, Math.PI * 2);
            ctx.fillStyle = `hsla(${p.hue}, 80%, 60%, ${alpha * 0.3})`;
            ctx.fill();
          }
          requestAnimationFrame(animate);
        }
        animate();

        window.addEventListener('resize', () => {
          width = window.innerWidth;
          height = window.innerHeight;
          canvas.width = width;
          canvas.height = height;
        });
      }

      // Initialize on first load and after every page transition
      initThemeToggle();
      initPageTransitions();
      initCursorTrail();

      document.addEventListener('astro:page-load', () => {
        initThemeToggle();
        initCursorTrail();
      });
    </script>
  </body>
</html>
