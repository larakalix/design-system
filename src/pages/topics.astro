---
import Layout from '../layouts/Layout.astro';
import Header from '../components/organisms/Header.astro';
import Footer from '../components/organisms/Footer.astro';
import TopicCard from '../components/molecules/TopicCard.astro';
import { Search, X } from 'lucide-astro';
import topicsData from '../data/topics.json';

const { categories, topics } = topicsData;
const categoryNames = Object.keys(categories);
---

<Layout title="All Topics - System Design Archive 2025">
  <Header />
  
  <main class="flex-1 max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12 w-full">
    <div class="text-center mb-12">
      <h1 class="text-4xl sm:text-5xl font-bold text-stone-900 dark:text-stone-100 mb-3">All Topics</h1>
      <p class="text-stone-500 dark:text-stone-400">Search and explore {topics.length} topics from the archive</p>
    </div>

    <div class="max-w-2xl mx-auto mb-8">
      <div class="relative">
        <Search class="absolute left-4 top-1/2 -translate-y-1/2 w-5 h-5 text-stone-400 dark:text-stone-500" />
        <input
          type="text"
          id="search-input"
          placeholder="Search topics..."
          class="w-full rounded-xl border border-stone-200 dark:border-stone-700 bg-white dark:bg-stone-900 px-4 py-4 pl-12 text-stone-900 dark:text-stone-100 placeholder:text-stone-400 dark:placeholder:text-stone-500 focus:border-emerald-500 focus:outline-none focus:ring-2 focus:ring-emerald-500/10 transition-all text-base"
        />
        <button
          id="clear-search"
          class="absolute right-4 top-1/2 -translate-y-1/2 p-1 rounded-lg text-stone-400 hover:text-stone-900 dark:hover:text-stone-100 hover:bg-stone-100 dark:hover:bg-stone-800 transition-all hidden"
          aria-label="Clear search"
        >
          <X class="w-4 h-4" />
        </button>
      </div>
    </div>

    <div class="flex items-center justify-center gap-2 overflow-x-auto pb-2 mb-10 scrollbar-hide">
      <button
        data-filter="all"
        class="filter-btn px-4 py-2 rounded-lg text-sm font-medium bg-stone-900 dark:bg-stone-100 text-white dark:text-stone-900 transition-all whitespace-nowrap"
      >
        All Topics
      </button>
      {categoryNames.map(cat => (
        <button
          data-filter={cat}
          class="filter-btn px-4 py-2 rounded-lg text-sm font-medium bg-white dark:bg-stone-900 border border-stone-200 dark:border-stone-700 text-stone-600 dark:text-stone-300 hover:border-stone-300 dark:hover:border-stone-600 hover:text-stone-900 dark:hover:text-stone-100 transition-all whitespace-nowrap"
        >
          {cat}
        </button>
      ))}
    </div>

    <div class="flex items-center justify-between mb-6">
      <p class="text-sm text-stone-400 dark:text-stone-500">
        Showing <span id="result-count" class="font-medium text-stone-900 dark:text-stone-100">{topics.length}</span> topics
      </p>
    </div>

    <div id="topics-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
      {topics.map(topic => (
        <div
          class="topic-item"
          data-title={topic.title.toLowerCase()}
          data-category={topic.category}
        >
          <TopicCard
            title={topic.title}
            slug={topic.slug}
            category={topic.category}
            categoryColor={categories[topic.category as keyof typeof categories]?.color || 'accent'}
            content={topic.content}
          />
        </div>
      ))}
    </div>

    <div id="empty-state" class="hidden text-center py-20">
      <div class="w-16 h-16 rounded-2xl bg-stone-100 dark:bg-stone-800 flex items-center justify-center mx-auto mb-4">
        <Search class="w-8 h-8 text-stone-400 dark:text-stone-500" />
      </div>
      <h3 class="text-lg font-semibold text-stone-900 dark:text-stone-100 mb-2">No topics found</h3>
      <p class="text-stone-500 dark:text-stone-400 mb-4">Try adjusting your search or filters</p>
      <button
        id="reset-filters"
        class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-emerald-600 text-white text-sm font-medium hover:bg-emerald-700 transition-all"
      >
        <X class="w-4 h-4" />
        Reset filters
      </button>
    </div>
  </main>
  
  <Footer />
</Layout>

<script>
  const searchInput = document.getElementById('search-input') as HTMLInputElement;
  const clearBtn = document.getElementById('clear-search');
  const filterBtns = document.querySelectorAll('.filter-btn');
  const topicItems = document.querySelectorAll('.topic-item');
  const resultCount = document.getElementById('result-count');
  const emptyState = document.getElementById('empty-state');
  const topicsGrid = document.getElementById('topics-grid');
  const resetBtn = document.getElementById('reset-filters');

  let activeFilter = 'all';
  let searchQuery = '';

  function updateVisibility() {
    let visible = 0;
    topicItems.forEach(item => {
      const title = item.getAttribute('data-title') || '';
      const category = item.getAttribute('data-category') || '';

      const matchesSearch = title.includes(searchQuery.toLowerCase());
      const matchesFilter = activeFilter === 'all' || category === activeFilter;

      if (matchesSearch && matchesFilter) {
        (item as HTMLElement).style.display = '';
        visible++;
      } else {
        (item as HTMLElement).style.display = 'none';
      }
    });

    if (resultCount) resultCount.textContent = String(visible);

    if (visible === 0) {
      emptyState?.classList.remove('hidden');
      topicsGrid?.classList.add('hidden');
    } else {
      emptyState?.classList.add('hidden');
      topicsGrid?.classList.remove('hidden');
    }

    if (searchQuery) {
      clearBtn?.classList.remove('hidden');
    } else {
      clearBtn?.classList.add('hidden');
    }
  }

  searchInput?.addEventListener('input', (e) => {
    searchQuery = (e.target as HTMLInputElement).value;
    updateVisibility();
  });

  clearBtn?.addEventListener('click', () => {
    searchQuery = '';
    if (searchInput) searchInput.value = '';
    updateVisibility();
    searchInput?.focus();
  });

  filterBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      filterBtns.forEach(b => {
        b.classList.remove('bg-stone-900', 'dark:bg-stone-100', 'text-white', 'dark:text-stone-900');
        b.classList.add('bg-white', 'dark:bg-stone-900', 'text-stone-600', 'dark:text-stone-300', 'border', 'border-stone-200', 'dark:border-stone-700');
      });
      btn.classList.remove('bg-white', 'dark:bg-stone-900', 'text-stone-600', 'dark:text-stone-300', 'border', 'border-stone-200', 'dark:border-stone-700');
      btn.classList.add('bg-stone-900', 'dark:bg-stone-100', 'text-white', 'dark:text-stone-900');

      activeFilter = btn.getAttribute('data-filter') || 'all';
      updateVisibility();
    });
  });

  resetBtn?.addEventListener('click', () => {
    searchQuery = '';
    activeFilter = 'all';
    if (searchInput) searchInput.value = '';

    filterBtns.forEach(b => {
      b.classList.remove('bg-stone-900', 'dark:bg-stone-100', 'text-white', 'dark:text-stone-900');
      b.classList.add('bg-white', 'dark:bg-stone-900', 'text-stone-600', 'dark:text-stone-300', 'border', 'border-stone-200', 'dark:border-stone-700');
    });
    const allBtn = document.querySelector('[data-filter="all"]');
    allBtn?.classList.remove('bg-white', 'dark:bg-stone-900', 'text-stone-600', 'dark:text-stone-300', 'border', 'border-stone-200', 'dark:border-stone-700');
    allBtn?.classList.add('bg-stone-900', 'dark:bg-stone-100', 'text-white', 'dark:text-stone-900');

    updateVisibility();
    searchInput?.focus();
  });

  searchInput?.focus();
</script>

<style>
  .scrollbar-hide::-webkit-scrollbar { display: none; }
  .scrollbar-hide { -ms-overflow-style: none; scrollbar-width: none; }
</style>
