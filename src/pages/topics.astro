---
import Layout from '../layouts/Layout.astro';
import Header from '../components/organisms/Header.astro';
import Footer from '../components/organisms/Footer.astro';
import TopicCard from '../components/molecules/TopicCard.astro';
import { Search, X, ChevronRight, BookOpen, Hash, Sparkles } from 'lucide-astro';
import topicsData from '../data/topics.json';

const { categories, topics } = topicsData;
const categoryNames = Object.keys(categories);

// Compute topic counts per category
const categoryCounts: Record<string, number> = {};
categoryNames.forEach(cat => {
  categoryCounts[cat] = topics.filter(t => t.category === cat).length;
});

// Get color mapping for categories
const categoryColors: Record<string, string> = {};
categoryNames.forEach(cat => {
  const meta = categories[cat as keyof typeof categories] as any;
  categoryColors[cat] = meta?.color || 'accent';
});
---

<Layout title="All Topics - System Design Archive 2025">
  <Header />

  <div class="flex max-w-[1440px] mx-auto">
    {/* ========== LEFT SIDEBAR ========== */}
    <aside class="hidden lg:block w-[260px] shrink-0 sticky top-16 h-[calc(100vh-4rem)] overflow-y-auto border-r border-stone-200 dark:border-stone-800">
      <nav class="py-8 px-5">
        {/* Section label */}
        <p class="text-[11px] font-semibold text-stone-400 dark:text-stone-500 uppercase tracking-wider mb-4 px-2">
          Categories
        </p>

        {/* All Topics link */}
        <button
          data-filter="all"
          class="filter-btn w-full text-left flex items-center gap-3 px-3 py-2 rounded-lg text-sm font-medium transition-all mb-1 bg-stone-100 dark:bg-stone-800 text-stone-900 dark:text-stone-100"
        >
          <BookOpen class="w-4 h-4 text-stone-500 dark:text-stone-400" />
          <span>All Topics</span>
          <span class="ml-auto text-xs text-stone-400 dark:text-stone-500 tabular-nums">{topics.length}</span>
        </button>

        {/* Category links */}
        <div class="mt-2 space-y-0.5">
          {categoryNames.map(cat => {
            const meta = categories[cat as keyof typeof categories] as any;
            const colorVar = `var(--color-${meta?.color || 'accent'})`;
            return (
              <button
                data-filter={cat}
                class="filter-btn w-full text-left flex items-center gap-3 px-3 py-2 rounded-lg text-sm text-stone-600 dark:text-stone-400 hover:bg-stone-100 dark:hover:bg-stone-800 hover:text-stone-900 dark:hover:text-stone-100 transition-all"
              >
                <span
                  class="w-2 h-2 rounded-full shrink-0"
                  style={`background-color: ${colorVar}`}
                />
                <span class="truncate">{cat}</span>
                <span class="ml-auto text-xs text-stone-400 dark:text-stone-500 tabular-nums">{categoryCounts[cat]}</span>
              </button>
            );
          })}
        </div>
      </nav>
    </aside>

    {/* ========== MAIN CONTENT ========== */}
    <main class="flex-1 min-w-0">
      <div class="max-w-3xl mx-auto px-6 sm:px-8 py-10">
        {/* Breadcrumbs */}
        <nav class="flex items-center gap-2 text-sm text-stone-500 dark:text-stone-400 mb-6">
          <a href="/" class="hover:text-stone-900 dark:hover:text-stone-100 transition-colors">Home</a>
          <ChevronRight class="w-3.5 h-3.5" />
          <span class="text-stone-900 dark:text-stone-100 font-medium">Topics</span>
        </nav>

        {/* Title + Description */}
        <h1 class="text-3xl sm:text-4xl font-bold text-stone-900 dark:text-stone-100 mb-3 tracking-tight">
          All Topics
        </h1>
        <p class="text-stone-500 dark:text-stone-400 text-base leading-relaxed mb-8">
          Browse {topics.length} topics covering system design, AI/ML, DevOps, networking, databases, and more.
        </p>

        {/* Search */}
        <div class="relative mb-8">
          <Search class="absolute left-4 top-1/2 -translate-y-1/2 w-4 h-4 text-stone-400 dark:text-stone-500" />
          <input
            type="text"
            id="search-input"
            placeholder="Search topics..."
            class="w-full rounded-lg border border-stone-200 dark:border-stone-700 bg-white dark:bg-stone-900 px-4 py-3 pl-11 text-stone-900 dark:text-stone-100 placeholder:text-stone-400 dark:placeholder:text-stone-500 focus:border-emerald-500 focus:outline-none focus:ring-2 focus:ring-emerald-500/10 transition-all text-sm"
          />
          <button
            id="clear-search"
            class="absolute right-3 top-1/2 -translate-y-1/2 p-1 rounded-md text-stone-400 hover:text-stone-900 dark:hover:text-stone-100 hover:bg-stone-100 dark:hover:bg-stone-800 transition-all hidden"
            aria-label="Clear search"
          >
            <X class="w-3.5 h-3.5" />
          </button>
        </div>

        {/* Mobile category pills */}
        <div class="flex lg:hidden items-center gap-2 overflow-x-auto pb-3 mb-6 scrollbar-hide">
          <button
            data-filter="all"
            class="filter-btn-mobile px-3 py-1.5 rounded-full text-xs font-medium bg-stone-900 dark:bg-stone-100 text-white dark:text-stone-900 transition-all whitespace-nowrap"
          >
            All ({topics.length})
          </button>
          {categoryNames.map(cat => (
            <button
              data-filter={cat}
              class="filter-btn-mobile px-3 py-1.5 rounded-full text-xs font-medium bg-white dark:bg-stone-900 border border-stone-200 dark:border-stone-700 text-stone-600 dark:text-stone-300 hover:border-stone-300 dark:hover:border-stone-600 transition-all whitespace-nowrap"
            >
              {cat} ({categoryCounts[cat]})
            </button>
          ))}
        </div>

        {/* Result count */}
        <p class="text-sm text-stone-400 dark:text-stone-500 mb-4">
          Showing <span id="result-count" class="font-medium text-stone-900 dark:text-stone-100">{topics.length}</span> topics
        </p>

        {/* Topics Grid */}
        <div id="topics-grid" class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          {topics.map(topic => (
            <div
              class="topic-item"
              data-title={topic.title.toLowerCase()}
              data-category={topic.category}
            >
              <TopicCard
                title={topic.title}
                slug={topic.slug}
                category={topic.category}
                categoryColor={categoryColors[topic.category] || 'accent'}
                content={topic.content}
              />
            </div>
          ))}
        </div>

        {/* Empty state */}
        <div id="empty-state" class="hidden text-center py-20">
          <div class="w-14 h-14 rounded-2xl bg-stone-100 dark:bg-stone-800 flex items-center justify-center mx-auto mb-4">
            <Search class="w-6 h-6 text-stone-400 dark:text-stone-500" />
          </div>
          <h3 class="text-lg font-semibold text-stone-900 dark:text-stone-100 mb-2">No topics found</h3>
          <p class="text-stone-500 dark:text-stone-400 mb-4 text-sm">Try adjusting your search or filters</p>
          <button
            id="reset-filters"
            class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-emerald-600 text-white text-sm font-medium hover:bg-emerald-700 transition-all"
          >
            <X class="w-4 h-4" />
            Reset filters
          </button>
        </div>
      </div>
    </main>

    {/* ========== RIGHT SIDEBAR ========== */}
    <aside class="hidden xl:block w-[240px] shrink-0 sticky top-16 h-[calc(100vh-4rem)] overflow-y-auto border-l border-stone-200 dark:border-stone-800">
      <div class="py-8 px-5">
        {/* Stats */}
        <div class="mb-8">
          <p class="text-[11px] font-semibold text-stone-400 dark:text-stone-500 uppercase tracking-wider mb-3 px-1">
            Overview
          </p>
          <div class="space-y-2">
            <div class="flex items-center justify-between px-2 py-1.5 rounded-md">
              <span class="text-sm text-stone-600 dark:text-stone-400">Total Topics</span>
              <span class="text-sm font-semibold text-stone-900 dark:text-stone-100 tabular-nums">{topics.length}</span>
            </div>
            <div class="flex items-center justify-between px-2 py-1.5 rounded-md">
              <span class="text-sm text-stone-600 dark:text-stone-400">Categories</span>
              <span class="text-sm font-semibold text-stone-900 dark:text-stone-100 tabular-nums">{categoryNames.length}</span>
            </div>
            <div class="flex items-center justify-between px-2 py-1.5 rounded-md">
              <span class="text-sm text-stone-600 dark:text-stone-400">Pages</span>
              <span class="text-sm font-semibold text-stone-900 dark:text-stone-100 tabular-nums">442</span>
            </div>
          </div>
        </div>

        {/* Top categories */}
        <div class="mb-8">
          <p class="text-[11px] font-semibold text-stone-400 dark:text-stone-500 uppercase tracking-wider mb-3 px-1">
            Top Categories
          </p>
          <div class="space-y-1">
            {categoryNames
              .sort((a, b) => categoryCounts[b] - categoryCounts[a])
              .slice(0, 5)
              .map(cat => {
                const meta = categories[cat as keyof typeof categories] as any;
                const colorVar = `var(--color-${meta?.color || 'accent'})`;
                return (
                  <button
                    data-filter={cat}
                    class="filter-btn w-full text-left flex items-center gap-2.5 px-2 py-1.5 rounded-md text-sm text-stone-600 dark:text-stone-400 hover:bg-stone-100 dark:hover:bg-stone-800 transition-all"
                  >
                    <span
                      class="w-1.5 h-1.5 rounded-full shrink-0"
                      style={`background-color: ${colorVar}`}
                    />
                    <span class="truncate">{cat}</span>
                    <span class="ml-auto text-xs text-stone-400 dark:text-stone-500 tabular-nums">{categoryCounts[cat]}</span>
                  </button>
                );
              })}
          </div>
        </div>

        {/* Tip */}
        <div class="rounded-xl border border-stone-200 dark:border-stone-800 bg-stone-50 dark:bg-stone-900/50 p-4">
          <div class="flex items-center gap-2 mb-2">
            <Sparkles class="w-3.5 h-3.5 text-amber-500" />
            <p class="text-xs font-semibold text-stone-700 dark:text-stone-300">Pro tip</p>
          </div>
          <p class="text-xs text-stone-500 dark:text-stone-400 leading-relaxed">
            Press <kbd class="px-1.5 py-0.5 rounded bg-white dark:bg-stone-800 border border-stone-200 dark:border-stone-700 text-[10px] font-mono text-stone-600 dark:text-stone-400">Ctrl</kbd> <kbd class="px-1.5 py-0.5 rounded bg-white dark:bg-stone-800 border border-stone-200 dark:border-stone-700 text-[10px] font-mono text-stone-600 dark:text-stone-400">K</kbd> to jump to search from anywhere.
          </p>
        </div>
      </div>
    </aside>
  </div>

  <Footer />
</Layout>

<script>
  const searchInput = document.getElementById('search-input') as HTMLInputElement;
  const clearBtn = document.getElementById('clear-search');
  const filterBtns = document.querySelectorAll('.filter-btn');
  const filterBtnsMobile = document.querySelectorAll('.filter-btn-mobile');
  const topicItems = document.querySelectorAll('.topic-item');
  const resultCount = document.getElementById('result-count');
  const emptyState = document.getElementById('empty-state');
  const topicsGrid = document.getElementById('topics-grid');
  const resetBtn = document.getElementById('reset-filters');

  let activeFilter = 'all';
  let searchQuery = '';

  function updateVisibility() {
    let visible = 0;
    topicItems.forEach(item => {
      const title = item.getAttribute('data-title') || '';
      const category = item.getAttribute('data-category') || '';

      const matchesSearch = title.includes(searchQuery.toLowerCase());
      const matchesFilter = activeFilter === 'all' || category === activeFilter;

      if (matchesSearch && matchesFilter) {
        (item as HTMLElement).style.display = '';
        visible++;
      } else {
        (item as HTMLElement).style.display = 'none';
      }
    });

    if (resultCount) resultCount.textContent = String(visible);

    if (visible === 0) {
      emptyState?.classList.remove('hidden');
      topicsGrid?.classList.add('hidden');
    } else {
      emptyState?.classList.add('hidden');
      topicsGrid?.classList.remove('hidden');
    }

    if (searchQuery) {
      clearBtn?.classList.remove('hidden');
    } else {
      clearBtn?.classList.add('hidden');
    }
  }

  function setActiveFilterDesktop(filter: string) {
    filterBtns.forEach(btn => {
      const isActive = btn.getAttribute('data-filter') === filter;
      if (isActive) {
        btn.classList.add('bg-stone-100', 'dark:bg-stone-800', 'text-stone-900', 'dark:text-stone-100', 'font-medium');
        btn.classList.remove('text-stone-600', 'dark:text-stone-400');
      } else {
        btn.classList.remove('bg-stone-100', 'dark:bg-stone-800', 'text-stone-900', 'dark:text-stone-100', 'font-medium');
        btn.classList.add('text-stone-600', 'dark:text-stone-400');
      }
    });
  }

  function setActiveFilterMobile(filter: string) {
    filterBtnsMobile.forEach(btn => {
      const isActive = btn.getAttribute('data-filter') === filter;
      if (isActive) {
        btn.classList.add('bg-stone-900', 'dark:bg-stone-100', 'text-white', 'dark:text-stone-900');
        btn.classList.remove('bg-white', 'dark:bg-stone-900', 'text-stone-600', 'dark:text-stone-300', 'border', 'border-stone-200', 'dark:border-stone-700');
      } else {
        btn.classList.remove('bg-stone-900', 'dark:bg-stone-100', 'text-white', 'dark:text-stone-900');
        btn.classList.add('bg-white', 'dark:bg-stone-900', 'text-stone-600', 'dark:text-stone-300', 'border', 'border-stone-200', 'dark:border-stone-700');
      }
    });
  }

  searchInput?.addEventListener('input', (e) => {
    searchQuery = (e.target as HTMLInputElement).value;
    updateVisibility();
  });

  clearBtn?.addEventListener('click', () => {
    searchQuery = '';
    if (searchInput) searchInput.value = '';
    updateVisibility();
    searchInput?.focus();
  });

  filterBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      activeFilter = btn.getAttribute('data-filter') || 'all';
      setActiveFilterDesktop(activeFilter);
      setActiveFilterMobile(activeFilter);
      updateVisibility();
    });
  });

  filterBtnsMobile.forEach(btn => {
    btn.addEventListener('click', () => {
      activeFilter = btn.getAttribute('data-filter') || 'all';
      setActiveFilterDesktop(activeFilter);
      setActiveFilterMobile(activeFilter);
      updateVisibility();
    });
  });

  resetBtn?.addEventListener('click', () => {
    searchQuery = '';
    activeFilter = 'all';
    if (searchInput) searchInput.value = '';
    setActiveFilterDesktop('all');
    setActiveFilterMobile('all');
    updateVisibility();
    searchInput?.focus();
  });

  searchInput?.focus();
</script>

<style>
  .scrollbar-hide::-webkit-scrollbar { display: none; }
  .scrollbar-hide { -ms-overflow-style: none; scrollbar-width: none; }
</style>
