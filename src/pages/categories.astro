---
import Layout from '../layouts/Layout.astro';
import Header from '../components/organisms/Header.astro';
import Footer from '../components/organisms/Footer.astro';
import TopicCard from '../components/molecules/TopicCard.astro';
import Badge from '../components/atoms/Badge.astro';
import { Layers } from 'lucide-astro';
import topicsData from '../data/topics.json';

const { categories, topics } = topicsData;

const categoryList = Object.entries(categories).map(([name, meta]: [string, any]) => ({
  name,
  slug: name.toLowerCase().replace(/\s+/g, '-'),
  ...meta,
  topics: topics.filter((t: any) => t.category === name),
}));
---

<Layout title="Categories - System Design Archive 2025">
  <Header />
  
  <main class="flex-1 max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12 w-full">
    <div class="text-center mb-16">
      <div class="inline-flex items-center justify-center w-10 h-10 rounded-xl bg-emerald-50 dark:bg-emerald-950/50 text-emerald-600 dark:text-emerald-400 mb-4">
        <Layers class="w-5 h-5" />
      </div>
      <h1 class="text-4xl sm:text-5xl font-bold text-stone-900 dark:text-stone-100 mb-3">Categories</h1>
      <p class="text-stone-500 dark:text-stone-400">Browse all {categoryList.length} knowledge domains</p>
    </div>

    <div class="space-y-20">
      {categoryList.map(cat => (
        <section id={cat.slug} class="scroll-mt-24">
          <div class="flex items-center gap-3 mb-6 pb-4 border-b border-stone-200 dark:border-stone-800">
            <Badge color={cat.color}>{cat.topics.length} topics</Badge>
            <h2 class="text-2xl font-bold text-stone-900 dark:text-stone-100">{cat.name}</h2>
          </div>
          <p class="text-stone-500 dark:text-stone-400 mb-6">{cat.description}</p>
          
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
            {cat.topics.map((topic: any) => (
              <TopicCard
                title={topic.title}
                slug={topic.slug}
                category={topic.category}
                categoryColor={cat.color}
                content={topic.content}
              />
            ))}
          </div>
        </section>
      ))}
    </div>
  </main>
  
  <Footer />
</Layout>
