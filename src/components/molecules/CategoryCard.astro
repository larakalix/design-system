---
import Badge from '../atoms/Badge.astro';
import { ArrowUpRight } from 'lucide-astro';

interface Props {
  name: string;
  slug: string;
  color: string;
  description: string;
  count: number;
}

const { name, slug, color, description, count } = Astro.props;
---

<a
  href={`/categories#${slug}`}
  class="group relative block p-6 bg-white dark:bg-stone-900 rounded-xl border border-stone-200 dark:border-stone-800 overflow-hidden transition-colors duration-300 hover:border-transparent"
>
  {/* Animated gradient border ring on hover */}
  <div
    class="absolute inset-0 rounded-xl opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none"
    style="background: linear-gradient(90deg, #10b981, #3b82f6, #8b5cf6, #f59e0b, #10b981); background-size: 400% 100%; animation: gradient-flow 3s linear infinite;"
  >
    <div class="absolute inset-[1.5px] rounded-[10px] bg-white dark:bg-stone-900"></div>
  </div>

  <div class="relative z-10">
    <div class="flex items-start justify-between mb-4">
      <Badge color={color}>{count} topics</Badge>
      <ArrowUpRight class="w-4 h-4 text-stone-400 dark:text-stone-500 group-hover:text-emerald-600 dark:group-hover:text-emerald-400 transition-colors" />
    </div>

    <h3 class="text-lg font-semibold text-stone-900 dark:text-stone-100 mb-1.5 group-hover:text-emerald-600 dark:group-hover:text-emerald-400 transition-colors">
      {name}
    </h3>

    <p class="text-sm text-stone-500 dark:text-stone-400 leading-relaxed">
      {description}
    </p>
  </div>
</a>

<style>
  @keyframes gradient-flow {
    0% { background-position: 0% 50%; }
    100% { background-position: 400% 50%; }
  }
</style>
