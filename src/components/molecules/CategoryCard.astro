---
import Badge from '../atoms/Badge.astro';
import { ArrowRight } from 'lucide-astro';

interface Props {
  name: string;
  slug: string;
  color: string;
  description: string;
  count: number;
}

const { name, slug, color, description, count } = Astro.props;

const colorBgMap: Record<string, string> = {
  'category-system': 'bg-blue-500',
  'category-ai': 'bg-violet-500',
  'category-api': 'bg-emerald-500',
  'category-database': 'bg-amber-500',
  'category-devops': 'bg-red-500',
  'category-networking': 'bg-cyan-500',
  'category-security': 'bg-pink-500',
  'category-programming': 'bg-indigo-500',
  'category-algorithms': 'bg-teal-500',
  'category-career': 'bg-orange-500',
};

const bgClass = colorBgMap[color] || 'bg-blue-500';
---

<a
  href={`/categories#${slug}`}
  class="group relative overflow-hidden rounded-2xl bg-surface border border-border card-hover p-6"
>
  <div class="absolute top-0 right-0 w-24 h-24 opacity-10 rounded-bl-full ${bgClass}"></div>
  
  <div class="relative">
    <div class="flex items-center justify-between mb-4">
      <Badge color={color}>{count} topics</Badge>
      <ArrowRight class="w-5 h-5 text-text-muted group-hover:text-accent group-hover:translate-x-1 transition-all" />
    </div>
    
    <h3 class="text-xl font-bold text-primary mb-2 group-hover:text-accent transition-colors">
      {name}
    </h3>
    
    <p class="text-sm text-text-muted leading-relaxed">
      {description}
    </p>
  </div>
</a>
