---
import Badge from '../atoms/Badge.astro';
import { ArrowRight, FileText } from 'lucide-astro';

interface Props {
  title: string;
  slug: string;
  category: string;
  categoryColor: string;
  content?: string;
}

const { title, slug, category, categoryColor, content } = Astro.props;

const preview = content ? content.slice(0, 120).replace(/\n/g, ' ') + '...' : '';
---

<a
  href={`/topic/${slug}`}
  class="group block p-5 rounded-2xl bg-surface border border-border card-hover"
>
  <div class="flex items-start justify-between gap-3 mb-3">
    <div class="flex items-center gap-2">
      <FileText class="w-4 h-4 text-text-muted flex-shrink-0" />
      <Badge color={categoryColor}>{category}</Badge>
    </div>
    <ArrowRight class="w-4 h-4 text-text-muted group-hover:text-accent group-hover:translate-x-1 transition-all" />
  </div>
  
  <h3 class="font-semibold text-text group-hover:text-accent transition-colors mb-2 line-clamp-2">
    {title}
  </h3>
  
  {preview && (
    <p class="text-sm text-text-muted line-clamp-2 leading-relaxed">
      {preview}
    </p>
  )}
</a>
