---
import { Heart, ExternalLink } from 'lucide-astro';
---

<footer class="mt-auto border-t border-stone-200 dark:border-stone-800 bg-white dark:bg-stone-950" transition:persist>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-10">
      <div class="space-y-3">
        <h3 class="font-semibold text-stone-900 dark:text-stone-100">SystemDesign.archive</h3>
        <p class="text-sm text-stone-500 dark:text-stone-400 leading-relaxed">
          An interactive, open knowledge base built from the Big Archive System Design 2025. Free for everyone to learn and explore.
        </p>
      </div>
      <div class="space-y-3">
        <h4 class="text-sm font-semibold text-stone-900 dark:text-stone-100">Explore</h4>
        <ul class="space-y-2">
          <li><a href="/topics" class="text-sm text-stone-500 dark:text-stone-400 hover:text-stone-900 dark:hover:text-stone-100 transition-colors">All Topics</a></li>
          <li><a href="/categories" class="text-sm text-stone-500 dark:text-stone-400 hover:text-stone-900 dark:hover:text-stone-100 transition-colors">Categories</a></li>
          <li><a href="/credits" class="text-sm text-stone-500 dark:text-stone-400 hover:text-stone-900 dark:hover:text-stone-100 transition-colors">Credits & Author</a></li>
        </ul>
      </div>
      <div class="space-y-3">
        <h4 class="text-sm font-semibold text-stone-900 dark:text-stone-100">Attribution</h4>
        <p class="text-sm text-stone-500 dark:text-stone-400 leading-relaxed">
          Content sourced from <strong class="text-stone-700 dark:text-stone-300">Big Archive System Design 2025</strong>. 
          All credit goes to the original authors.
        </p>
        <a 
          href="/credits" 
          class="inline-flex items-center gap-1 text-sm text-emerald-600 dark:text-emerald-400 hover:text-emerald-700 dark:hover:text-emerald-300 transition-colors"
        >
          Read full credits <ExternalLink class="w-3 h-3" />
        </a>
      </div>
    </div>
    <div class="mt-10 pt-8 border-t border-stone-200 dark:border-stone-800 flex flex-col sm:flex-row items-center justify-between gap-4">
      <p class="text-xs text-stone-400 dark:text-stone-500">
        Built with <Heart class="w-3 h-3 inline text-red-500" /> for the community.
      </p>
      <p class="text-xs text-stone-400 dark:text-stone-500">
        Free & Open Knowledge
      </p>
    </div>
  </div>
</footer>
