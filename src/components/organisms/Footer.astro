---
import { Heart, Github, ExternalLink } from 'lucide-astro';
---

<footer class="mt-auto border-t border-border bg-surface">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <!-- Brand -->
      <div class="space-y-3">
        <h3 class="font-bold text-lg text-primary">SystemDesign.archive</h3>
        <p class="text-sm text-text-muted leading-relaxed">
          An interactive, open knowledge base built from the Big Archive System Design 2025. Free for everyone to learn and explore.
        </p>
      </div>

      <!-- Links -->
      <div class="space-y-3">
        <h4 class="font-semibold text-sm text-primary">Explore</h4>
        <ul class="space-y-2">
          <li><a href="/topics" class="text-sm text-text-muted hover:text-accent transition-colors">All Topics</a></li>
          <li><a href="/categories" class="text-sm text-text-muted hover:text-accent transition-colors">Categories</a></li>
          <li><a href="/credits" class="text-sm text-text-muted hover:text-accent transition-colors">Credits & Author</a></li>
        </ul>
      </div>

      <!-- Attribution -->
      <div class="space-y-3">
        <h4 class="font-semibold text-sm text-primary">Attribution</h4>
        <p class="text-sm text-text-muted leading-relaxed">
          Content sourced from <strong>Big Archive System Design 2025</strong>. 
          All credit goes to the original authors.
        </p>
        <a 
          href="/credits" 
          class="inline-flex items-center gap-1 text-sm text-accent hover:text-accent-hover transition-colors"
        >
          Read full credits <ExternalLink class="w-3 h-3" />
        </a>
      </div>
    </div>

    <div class="mt-8 pt-8 border-t border-border flex flex-col sm:flex-row items-center justify-between gap-4">
      <p class="text-xs text-text-muted">
        Built with <Heart class="w-3 h-3 inline text-red-500" /> for the community. Not affiliated with the original publisher.
      </p>
      <p class="text-xs text-text-muted">
        Free & Open Knowledge
      </p>
    </div>
  </div>
</footer>
