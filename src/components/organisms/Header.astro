---
import { Search, Menu, X, BookOpen, Sun, Moon } from 'lucide-astro';

const navLinks = [
  { href: '/', label: 'Home' },
  { href: '/topics', label: 'All Topics' },
  { href: '/categories', label: 'Categories' },
  { href: '/credits', label: 'Credits' },
];
---

<header class="sticky top-0 z-50 glass border-b border-border">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">
      <!-- Logo -->
      <a href="/" class="flex items-center gap-2 group">
        <div class="w-8 h-8 rounded-lg bg-accent flex items-center justify-center">
          <BookOpen class="w-5 h-5 text-white" />
        </div>
        <span class="font-bold text-lg text-primary group-hover:text-accent transition-colors">SystemDesign<span class="text-accent">.archive</span></span>
      </a>

      <!-- Desktop Nav -->
      <nav class="hidden md:flex items-center gap-1">
        {navLinks.map(link => (
          <a
            href={link.href}
            class="px-3 py-2 rounded-lg text-sm font-medium text-text-muted hover:text-text hover:bg-surface-muted transition-all"
          >
            {link.label}
          </a>
        ))}
      </nav>

      <!-- Search + Theme + Mobile Menu -->
      <div class="flex items-center gap-2">
        <a
          href="/topics"
          class="hidden sm:flex items-center gap-2 px-3 py-2 rounded-lg text-sm text-text-muted bg-surface-muted border border-border hover:border-accent/50 transition-all"
        >
          <Search class="w-4 h-4" />
          <span class="text-xs">Search topics...</span>
          <kbd class="hidden lg:inline-flex px-1.5 py-0.5 text-xs font-mono bg-surface border border-border rounded">⌘K</kbd>
        </a>

        <!-- Dark mode toggle -->
        <button
          id="theme-toggle"
          class="p-2 rounded-lg text-text-muted hover:text-text hover:bg-surface-muted transition-all"
          aria-label="Toggle dark mode"
        >
          <Sun class="w-5 h-5 dark:hidden" />
          <Moon class="w-5 h-5 hidden dark:block" />
        </button>
        
        <button
          id="mobile-menu-btn"
          class="md:hidden p-2 rounded-lg text-text-muted hover:text-text hover:bg-surface-muted transition-all"
          aria-label="Toggle menu"
        >
          <Menu class="w-5 h-5 menu-open" />
          <X class="w-5 h-5 menu-close hidden" />
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Menu -->
  <div id="mobile-menu" class="hidden md:hidden border-t border-border bg-surface">
    <div class="px-4 py-3 space-y-1">
      {navLinks.map(link => (
        <a
          href={link.href}
          class="block px-3 py-2 rounded-lg text-sm font-medium text-text-muted hover:text-text hover:bg-surface-muted transition-all"
        >
          {link.label}
        </a>
      ))}
      <a
        href="/topics"
        class="sm:hidden flex items-center gap-2 px-3 py-2 rounded-lg text-sm text-text-muted hover:bg-surface-muted transition-all"
      >
        <Search class="w-4 h-4" />
        Search topics
      </a>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const openIcon = btn?.querySelector('.menu-open');
  const closeIcon = btn?.querySelector('.menu-close');

  btn?.addEventListener('click', () => {
    menu?.classList.toggle('hidden');
    openIcon?.classList.toggle('hidden');
    closeIcon?.classList.toggle('hidden');
  });

  // Dark mode toggle
  const themeToggle = document.getElementById('theme-toggle');
  themeToggle?.addEventListener('click', () => {
    const html = document.documentElement;
    if (html.classList.contains('dark')) {
      html.classList.remove('dark');
      localStorage.setItem('theme', 'light');
    } else {
      html.classList.add('dark');
      localStorage.setItem('theme', 'dark');
    }
  });

  // Keyboard shortcut for search
  document.addEventListener('keydown', (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
      e.preventDefault();
      window.location.href = '/topics';
    }
  });
</script>
