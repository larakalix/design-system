---
interface Props {
  color?: string;
  children: any;
}

const { color = 'accent' } = Astro.props;

const colorMap: Record<string, string> = {
  'category-system': 'bg-blue-50 text-blue-700 border-blue-200',
  'category-ai': 'bg-violet-50 text-violet-700 border-violet-200',
  'category-api': 'bg-emerald-50 text-emerald-700 border-emerald-200',
  'category-database': 'bg-amber-50 text-amber-700 border-amber-200',
  'category-devops': 'bg-red-50 text-red-700 border-red-200',
  'category-networking': 'bg-cyan-50 text-cyan-700 border-cyan-200',
  'category-security': 'bg-pink-50 text-pink-700 border-pink-200',
  'category-programming': 'bg-indigo-50 text-indigo-700 border-indigo-200',
  'category-algorithms': 'bg-teal-50 text-teal-700 border-teal-200',
  'category-career': 'bg-orange-50 text-orange-700 border-orange-200',
  'accent': 'bg-blue-50 text-blue-700 border-blue-200',
};
---

<span class={`inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium border ${colorMap[color] || colorMap['accent']}`}>
  <slot />
</span>
