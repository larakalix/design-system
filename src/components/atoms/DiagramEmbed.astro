---
export interface Props {
  src: string;
  title?: string;
  height?: number;
}

const { src, title, height = 500 } = Astro.props;
---

<div class="diagram-embed w-full rounded-xl border border-stone-200 dark:border-stone-700 bg-stone-50 dark:bg-stone-900 overflow-hidden">
  {title && (
    <div class="px-4 py-3 border-b border-stone-200 dark:border-stone-700 bg-white dark:bg-stone-800">
      <h3 class="text-sm font-semibold text-stone-900 dark:text-stone-100">{title}</h3>
      <p class="text-xs text-stone-500 dark:text-stone-400 mt-0.5">Static diagram · Right-click to open full size</p>
    </div>
  )}
  <div class="w-full overflow-x-auto" style={`height: ${height}px;`}>
    <iframe
      src={src}
      class="w-full h-full border-0"
      loading="lazy"
      title={title || 'Diagram'}
    />
  </div>
</div>

<style>
  .diagram-embed iframe {
    background: transparent;
  }
</style>
